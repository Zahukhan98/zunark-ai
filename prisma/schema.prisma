generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DEVELOPER
}

enum InquiryStatus {
  NEW
  REVIEWED
  CONVERTED
  DECLINED
}

enum ProjectStatus {
  NEW
  DISCOVERY
  PLANNING
  PROPOSAL
  APPROVED
  IN_DEVELOPMENT
  TESTING
  DEPLOYMENT
  LIVE
  MAINTENANCE
  COMPLETED
  CANCELLED
}

enum RequirementStatus {
  DRAFT
  AI_GENERATED
  APPROVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments      ProjectAssignment[]
  aiConversations  AiConversation[]
  tasks            Task[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  uploadedDocuments Document[]

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  country   String?
  industry  String?
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("clients")
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String?
  country     String?
  industry    String?
  projectType String
  budget      String?
  timeline    String?
  description String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())

  @@map("inquiries")
}

model Project {
  id             String        @id @default(cuid())
  client         Client        @relation(fields: [clientId], references: [id])
  clientId       String
  name           String
  type           String
  description    String?
  status         ProjectStatus @default(NEW)
  budget         Decimal?      @db.Decimal(12, 2)
  clientPrice    Decimal?      @db.Decimal(12, 2)
  estimatedCost  Decimal?      @db.Decimal(12, 2)
  timeline       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignments     ProjectAssignment[]
  requirements    Requirement[]
  features        Feature[]
  tasks           Task[]
  documents       Document[]
  aiConversations AiConversation[]
  infrastructure  Infrastructure[]
  domains         Domain[]
  deployments     Deployment[]
  costs           Cost[]
  billing         Billing?

  @@map("projects")
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_assignments")
}

model Requirement {
  id                String             @id @default(cuid())
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  rawInput          String
  structuredOutput  String?
  status            RequirementStatus  @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("requirements")
}

model Feature {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  status      String   @default("planned")
  createdAt   DateTime @default(now())

  @@map("features")
}

model Task {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assignedTo  User?      @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("tasks")
}

model Document {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  name         String
  type         String
  fileUrl      String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())

  @@map("documents")
}

model AiConversation {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id              String         @id @default(cuid())
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  String
  role            String
  content         String
  tokensInput     Int?
  tokensOutput    Int?
  estimatedCost   Decimal?       @db.Decimal(10, 4)
  createdAt       DateTime       @default(now())

  @@map("ai_messages")
}

model Infrastructure {
  id                    String  @id @default(cuid())
  project               Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             String
  domain                String?
  hostingProvider       String?
  serverSpec            String?
  database              String?
  storage               String?
  estimatedMonthlyCost  Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())

  @@map("infrastructure")
}

model Domain {
  id         String    @id @default(cuid())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  domain     String
  registrar  String?
  registeredAt DateTime?
  renewsAt   DateTime?
  cost       Decimal?  @db.Decimal(10, 2)

  @@map("domains")
}

model Deployment {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  environment String
  status      String
  deployedAt  DateTime?
  createdAt   DateTime @default(now())

  @@map("deployments")
}

model Cost {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  period    String
  createdAt DateTime @default(now())

  @@map("costs")
}

model Billing {
  id            String   @id @default(cuid())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String   @unique
  quotedAmount  Decimal? @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("QUOTED")
  updatedAt     DateTime @updatedAt

  @@map("billing")
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())

  @@map("activity_logs")
}
