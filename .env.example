# Local MySQL (native install, no Docker needed)
DATABASE_URL="mysql://zunark:zunark_dev_password@localhost:3306/zunark_ai"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"

# Anthropic Claude API (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY="sk-ant-replace-me"

# Seed script — initial account passwords (change after first login)
SEED_SUPER_ADMIN_PASSWORD="change-me-1"
SEED_ADMIN_PASSWORD="change-me-2"
SEED_DEVELOPER_PASSWORD="change-me-3"
